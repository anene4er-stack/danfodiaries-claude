# Example environment variables

# Anthropic API key
ANTHROPIC_API_KEY=

# Optional override for model name
CLAUDE_MODEL=claude-sonnet-5-5

# Optional server port
PORT=3000

# Sign-in (Supabase). Leave REQUIRE_AUTH off until the Supabase values below are filled in.
# When REQUIRE_AUTH=true, reflections and chat need a signed-in user.
REQUIRE_AUTH=false
SUPABASE_URL=
# Public "anon" key (safe for the browser). Never put the service_role key here.
SUPABASE_ANON_KEY=
# Only for older projects that sign tokens with a shared secret (HS256). Newer projects
# use public keys that the server reads from SUPABASE_URL automatically.
SUPABASE_JWT_SECRET=
